# Copy to .env if you use a local environment-variable loader.
# The Flask command in the README does not automatically load this file.
FLASK_DEBUG=false
PORT=5000

# Advanced previews download full FITS images; use only on suitable machines.
SPHEREX_ALLOW_ADVANCED=true
SPHEREX_CACHE_DIR=.cache/spherex
SPHEREX_PREVIEW_CACHE_MB=512
SPHEREX_PREVIEW_CACHE_FILES=2500
SPHEREX_MAX_FULL_FITS_MB=2048
SPHEREX_FULL_CACHE_MB=8192
SPHEREX_MAX_FULL_PIXELS=150000000
